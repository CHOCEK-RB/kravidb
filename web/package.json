{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format:biome": "biome format --write .",
    "format:svelte": "prettier --write \"**/*.svelte\"",
    "format": "bun run format:biome && bun run format:svelte",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:biome": "biome check .",
    "lint:svelte": "eslint .",
    "check:types": "svelte-check --tsconfig ./tsconfig.app.json --threshold warning",
    "check:knip": "knip",
    "check:audit": "bun audit",
    "check:all": "bun run format && bun run lint:biome && bun run lint && bun run check:types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "tailwindcss": "^4.3.3"
  }
}
