---
# clang-tidy configuration for the test suite.
#
# GoogleTest macros (TEST/TEST_F/EXPECT_THROW) generate static constructors
# that can throw, use `new` on non-owning pointers and emit `goto`; those style
# checks do not apply to test code. Flow analysis also does not model
# ASSERT_TRUE/EXPECT_TRUE, so the `std::optional` check only produces false
# positives. The remaining rules are inherited from the root `.clang-tidy`.
InheritParentConfig: true
Checks: >
  -cert-err58-cpp,
  -bugprone-throwing-static-initialization,
  -bugprone-unchecked-optional-access,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-goto,
  -modernize-use-trailing-return-type,
  -modernize-type-traits
