#!/usr/bin/env bash
set -e

# Revision incremental: solo los archivos C++ que entran al commit.
# El CI y `xmake lint` sin variables siguen revisando todo el proyecto.
staged=$(git diff --cached --name-only --diff-filter=d -- src tests benchmarks \
  | grep -E '\.(cpp|cppm)$' || true)

if [ -z "$staged" ]; then
  echo "[pre-commit] Sin fuentes C++ en el commit; nada que revisar."
  exit 0
fi

export KRAVIDB_LINT_FILES
KRAVIDB_LINT_FILES=$(printf '%s' "$staged" | tr '\n' ' ')

echo "[pre-commit] xmake lint (${KRAVIDB_LINT_FILES})..."
xmake lint

echo "[pre-commit] All checks passed."
