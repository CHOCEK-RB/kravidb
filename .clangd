CompileFlags:
  CompilationDatabase: .
  Add:
    - -std=c++23

Diagnostics:
  ClangTidy:
    Add:
      - modernize-*
      - bugprone-*
      - cppcoreguidelines-*
      - cert-*
    # Mantener las exclusiones de .clang-tidy (el Add de arriba las re-encendia).
    Remove:
      - bugprone-exception-escape
